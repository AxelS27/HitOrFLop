{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "website/frontend/dist" }
    },
    {
      "src": "website/backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "website/backend/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/website/frontend/dist/$1"
    }
  ]
}
